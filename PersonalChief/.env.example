# ===== 大模型 =====
# 方式一：DeepSeek 官方集成（langchain-deepseek）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 方式二：OpenAI 兼容接口（如 DeepSeek 的 OpenAI 兼容端点）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== 阿里云 OSS（不上传图片可不配）=====
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxx
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ===== LangSmith 链路追踪（可选）=====
# LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxx
# LANGSMITH_TRACING=true
